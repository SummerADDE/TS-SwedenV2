{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TSC: Sync Scripts to Steam",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "ByPass",
                "-File", "${workspaceFolder}\\sync-scripts.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        }
    ]
}
